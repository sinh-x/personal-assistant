{
  "name": "personal-assistant",
  "version": "0.4.7",
  "type": "module",
  "description": "CLI agent team orchestrator for NixOS",
  "main": "dist/cli.mjs",
  "bin": {
    "pa": "dist/cli.mjs"
  },
  "scripts": {
    "build": "tsup",
    "test": "tsc --noEmit && pnpm test:doc-ref",
    "test:doc-ref": "pnpm build && npx tsx src/lib/tickets/__tests__/doc-ref.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "dev": "tsup --watch",
    "bump:patch": "bash scripts/dev/version_bump.sh patch",
    "bump:minor": "bash scripts/dev/version_bump.sh minor",
    "bump:major": "bash scripts/dev/version_bump.sh major",
    "bump:refresh-hash": "bash scripts/dev/version_bump.sh --refresh-hash"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.3.0",
    "better-sqlite3": "11.6.0",
    "commander": "^13.1.0",
    "hono": "^4.7.5",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0",
    "marked-terminal": "^7.2.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "picomatch": ">=4.0.4"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0"
}
